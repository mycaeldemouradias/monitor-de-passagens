# Copie para ".env" para rodar no Mac. No GitHub, cadastre os mesmos nomes em
# Settings → Secrets and variables → Actions → New repository secret.

# Google Flights via SerpApi — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Telegram — token do @BotFather e o seu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via CallMeBot (uso pessoal) — número com DDI, ex.: +5581999999999
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Chave da criptografia das viagens e do histórico (o repositório é público).
# Gere com: PYTHONPATH=src .venv/bin/python -m monitor.cofre nova-chave
MONITOR_CHAVE=
